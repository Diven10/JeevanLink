generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  RECIPIENT
  HOSPITAL
  BLOOD_BANK
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum DonorEligibility {
  ELIGIBLE
  TEMPORARILY_INELIGIBLE
  PERMANENTLY_INELIGIBLE
}

enum RequestUrgency {
  NORMAL
  URGENT
  EMERGENCY
}

enum RequestStatus {
  PENDING
  MATCHING
  MATCHED
  ACCEPTED
  FULFILLED
  REJECTED
  CANCELLED
}

enum MatchStatus {
  POTENTIAL
  NOTIFIED
  ACCEPTED
  DECLINED
}

enum OrganType {
  KIDNEY
  LIVER
  HEART
  CORNEA
  LUNGS
  PANCREAS
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor     Donor?
  hospital  Hospital?
  bloodBank BloodBank?
  recipient Recipient?
  organDonor OrganDonor?
  
  notifications Notification[]
  auditLogs AuditLog[]
}

model Donor {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id])
  bloodGroup     BloodGroup
  eligibility    DonorEligibility @default(ELIGIBLE)
  lastDonation   DateTime?
  donationCount  Int              @default(0)
  latitude       Float?
  longitude      Float?
  address        String?
  city           String?

  matches        Match[]
  donations      Donation[]
  appointments   Appointment[]
}

model Recipient {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  bloodGroup BloodGroup
  address    String?
  city          String?
  bloodRequests BloodRequest[]
}

model Hospital {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id])
  isVerified   Boolean        @default(false)
  latitude     Float?
  longitude    Float?
  address      String?
  city         String?
  
  bloodRequests BloodRequest[]
  organRequests OrganRequest[]
}

model BloodBank {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  isVerified Boolean  @default(false)
  latitude   Float?
  longitude  Float?
  address    String?
  city         String?

  inventory    BloodInventory[]
  appointments Appointment[]
}

model BloodInventory {
  id          String     @id @default(uuid())
  bloodBankId String
  bloodBank   BloodBank  @relation(fields: [bloodBankId], references: [id])
  bloodGroup  BloodGroup
  units       Int        @default(0)
  expiryDate  DateTime?
  storageCondition String?
  updatedAt   DateTime   @updatedAt
  
  @@unique([bloodBankId, bloodGroup])
}

model BloodRequest {
  id          String         @id @default(uuid())
  hospitalId  String?
  hospital    Hospital?      @relation(fields: [hospitalId], references: [id])
  recipientId String?
  recipient   Recipient?     @relation(fields: [recipientId], references: [id])
  bloodGroup  BloodGroup
  units       Int
  urgency     RequestUrgency @default(NORMAL)
  status      RequestStatus  @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  matches     Match[]
  requiredDate DateTime?
  city        String?
  state       String?
}

model Match {
  id             String        @id @default(uuid())
  bloodRequestId String
  bloodRequest   BloodRequest  @relation(fields: [bloodRequestId], references: [id])
  donorId        String
  donor          Donor         @relation(fields: [donorId], references: [id])
  status         MatchStatus   @default(POTENTIAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([bloodRequestId, donorId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Donation {
  id        String   @id @default(uuid())
  donorId   String
  donor     Donor    @relation(fields: [donorId], references: [id])
  date      DateTime @default(now())
  units     Int      @default(1)
  location  String?
}


model Appointment {
  id          String   @id @default(uuid())
  donorId     String
  donor       Donor    @relation(fields: [donorId], references: [id])
  bloodBankId String
  bloodBank   BloodBank @relation(fields: [bloodBankId], references: [id])
  scheduledAt DateTime
  status      String   @default("BOOKED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model OrganDonor {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  bloodGroup  BloodGroup
  organs      String   // Comma separated list of OrganType or JSON
  medicalHistory String?
  emergencyContact String?
  consent Boolean @default(false)
  consentDate DateTime @default(now())
  withdrawnAt DateTime?
}

model OrganRequest {
  id         String         @id @default(uuid())
  hospitalId String
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  organType  OrganType
  bloodGroup BloodGroup
  urgency    RequestUrgency @default(NORMAL)
  status     RequestStatus  @default(PENDING)
  patientName String?
  patientDetails String?
  city       String?
  supportingDocument String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}
